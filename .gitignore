# ============================================
# UM Multimedia Manager — .gitignore
# ============================================

# ----- Dependencies -----
node_modules/

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----- Environment variables -----
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.production
.env.staging
.env.test
.env.test.local
.envrc
.direnv/
.flox/
.npmrc
.yarnrc

# ----- Build output -----
dist/
dist-ssr/
build/
extension/
releases/
*.local

# ----- WXT build artifacts -----
.wxt/

# ----- Vite cache -----
.vite/

# ----- TypeScript build info -----
*.tsbuildinfo

# ----- Test artifacts (tests/ source files ARE tracked) -----
/playwright-report/
/test-results/
/coverage/
/.playwright/
playwright/.cache/

# ----- Editor directories and files -----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store*
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~
*.crswap
*.crswap.*
*.tmp
*.temp
*.sublime-project
*.sublime-workspace
*.iml
*.ipr
*.iws
.fleet/
.eclipse/

# ----- Linting / formatting caches -----
.eslintcache
.stylelintcache
.prettiercache
.prettierd/
.dprint/
.biome/

# ----- AI Assistant directories -----
.agents/
.claude/
.cursor/
.windsurf/
.kiro/
.roo/
.augment/
.codex/
.lingma/
.continue/
.aider/
.codeium/
.tabnine/
.sourcegraph/
.github/copilot-instructions.md
.copilot*

# ----- AI Agent sessions / configs -----
.sisyphus/
.omo/
.opencode/
.codegraph
.cortexkit/

# ----- MCP server configs -----
.mcp*.json
.mcp/

# ----- Package manager (Yarn Berry / PnP) -----
.yarn/
!.yarn/releases
!.yarn/plugins
!.yarn/patches
.yarnrc.yml
.pnp.*

# ----- Platform build artifacts -----
.vercel/
.netlify/
.wrangler/

# ----- Build tool caches -----
.turbo/
.parcel-cache/
.webpack/
.output/
.rollup.cache/
.esbuild/
.cache/
.sass-cache/
*.css.map

# ----- Archives and extension packages -----
*.tgz
*.zip
*.crx
*.xpi

# ----- Dev/test temp directories -----

# ----- Local reference data (offline page snapshots for extractor dev; 8.6M, never tracked) -----
.localref/
localref/
data-exports/
data-imports/
scratch/
tmp/
downloads/
fixtures/generated/
extracted/
storybook-static/
review_diff*.txt
docs/*-plan.md

# ----- Script runtime artifacts -----
scripts/*.log
scripts/tmp/
scripts/archived/

# ----- Puppeteer / Cypress / WebdriverIO -----
puppeteer/
cypress/videos/
cypress/screenshots/
cypress/downloads/
.wdio/

# ----- Code coverage -----
.nyc_output/

# ----- Visual regression test screenshots -----
backstop_data/bitmaps_test/
backstop_data/html_report/

# ----- Playwright browser binaries -----
ms-playwright/
playwright-*.json
chrome-user-data/

# ----- Test snapshot diffs -----
tests/__snapshots__/__diff_output__/
tests/__snapshots__/__new_output__/

# ----- Secrets / certificates -----
*.key
*.pem
*.crt
*.cert
*.p12
*.pfx
.sentryclirc

# ----- Docker -----
.docker/
docker-compose.override.yml
Dockerfile.*.local
.devcontainer/

# ----- Runtime / daemon output -----
nohup.out
*.pid
*.pid.lock

# ----- OS metadata -----
.Trashes
.fseventsd
.VolumeIcon.icns
._*

# ----- Stale directories from refactors -----
**/__pycache__/
*.egg-info/
